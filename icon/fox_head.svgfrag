  <polygon points="146,244 200,250 210,268 168,272" fill="#1B0E05"/>
  <polygon points="366,244 312,250 302,268 344,272" fill="#1B0E05"/>
  <polygon points="176,252 190,254 186,262" fill="#FFD9A0"/>
  <polygon points="336,252 322,254 326,262" fill="#FFD9A0"/>
